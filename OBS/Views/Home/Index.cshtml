@{
    ViewData["Title"] = "Ana Sayfa";
}

<style>
    .hero-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-box {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
        color: white;
        border-radius: 20px;
        padding: 4rem 3rem;
        text-align: center;
        max-width: 520px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(37, 99, 235, 0.25);
    }

    .hero-box .logo {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .hero-box h1 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .hero-box p {
        opacity: 0.8;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .hero-box .btn {
        padding: 0.65rem 2rem;
        font-weight: 600;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .btn-white {
        background: #fff;
        color: #2563eb;
        border: none;
    }

    .btn-white:hover {
        background: #f0f4ff;
        color: #1d4ed8;
    }

    .btn-outline-white {
        background: transparent;
        color: #fff;
        border: 2px solid rgba(255,255,255,0.5);
    }

    .btn-outline-white:hover {
        background: rgba(255,255,255,0.1);
        color: #fff;
        border-color: #fff;
    }
</style>

<div class="hero-wrap">
    <div class="hero-box">
        <div class="logo">📚</div>
        <h1>OBS</h1>
        <p>Öğrenci Bilgi Sistemi'ne hoş geldiniz.</p>

        @if (!User.Identity!.IsAuthenticated)
        {
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Auth" asp-action="Login" class="btn btn-white">Giriş Yap</a>
            </div>
        }
        else
        {
            <p class="mb-0">👋 Hoş geldin, <strong>@User.Identity.Name</strong></p>
            <form asp-action="Logout" asp-controller="Auth" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-white">Çıkış Yap</button>
            </form>
        }
    </div>
</div>
