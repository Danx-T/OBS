@model OBS.ViewModels.Academician.AcademicianCourseStudentsViewModel
@{
    ViewData["Title"] = "Dersi Alan Öğrenciler";
}

<style>
    :root {
        --primary: #4338ca;
        --secondary: #64748b;
        --card-bg: rgba(255, 255, 255, 0.95);
    }
    
    .page-header {
        background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
        border-radius: 16px;
        padding: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    .page-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 8px 0;
    }

    .page-subtitle {
        font-size: 1.1rem;
        color: var(--secondary);
        margin: 0;
    }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        padding: 24px;
    }

    .student-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .student-table th {
        color: var(--secondary);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 10px 15px;
        border-bottom: 2px solid #e2e8f0;
    }

    .student-row {
        background: white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        transition: transform 0.15s;
    }

    .student-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .student-row td {
        padding: 15px;
        vertical-align: middle;
    }

    .student-row td:first-child {
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }
    .student-row td:last-child {
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    .student-name {
        font-weight: 700;
        color: #1e293b;
    }

    .student-no {
        font-family: monospace;
        background: #f1f5f9;
        padding: 4px 8px;
        border-radius: 4px;
        color: var(--primary);
        font-weight: 600;
    }
</style>

<div class="container-fluid">
    <div class="mb-3">
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm fw-bold">
            &larr; Derslerime Dön
        </a>
    </div>

    <div class="page-header">
        <div>
            <h1>@Model.AcilanDers.Ders.DersKodu - @Model.AcilanDers.Ders.DersAdi</h1>
            <p class="page-subtitle">Şube: @Model.AcilanDers.SubeNo | Toplam Öğrenci: @Model.DersKayitlari.Count</p>
        </div>
        <div class="bg-primary bg-opacity-10 text-primary px-4 py-2 rounded-pill fw-bold">
            @Model.AcilanDers.Donem.AkademikYil - @Model.AcilanDers.Donem.Donem1 Dönemi
        </div>
    </div>

    <div class="glass-card">
        @if (!Model.DersKayitlari.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1 mb-3">📭</div>
                <h5>Öğrenci Bulunamadı</h5>
                <p>Bu derse henüz kayıtlı ve kaydı onaylanmış öğrenci bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="student-table">
                    <thead>
                        <tr>
                            <th>Öğrenci No</th>
                            <th>Ad Soyad</th>
                            <th>Bölüm / Program</th>
                            <th>Sınıf</th>
                            <th>Kayıt Durumu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kayit in Model.DersKayitlari)
                        {
                            <tr class="student-row">
                                <td>
                                    <span class="student-no">@kayit.Ogrenci.OgrenciNo</span>
                                </td>
                                <td>
                                    <div class="student-name">@kayit.Ogrenci.Kullanici.Ad @kayit.Ogrenci.Kullanici.Soyad</div>
                                </td>
                                <td class="text-secondary fw-medium">
                                    @kayit.Ogrenci.Organizasyon.Adi
                                </td>
                                <td class="text-secondary">
                                    @kayit.Ogrenci.Sinif. Sınıf
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                        @kayit.KayitDurumu
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

