@model OBS.ViewModels.Academician.AcademicianGradeEntryViewModel
@{
    ViewData["Title"] = "Not Girişi";
}

<style>
    :root {
        --primary: #4338ca;
        --secondary: #64748b;
        --card-bg: rgba(255, 255, 255, 0.95);
        --muted: #94a3b8;
    }
    
    .exams-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 15px;
    }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        padding: 24px;
    }

    .page-header-card {
        background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
        border-radius: 16px;
        padding: 24px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    .page-header-card h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 5px 0;
    }
    
    .page-header-card p {
        margin: 0;
        color: var(--secondary);
        font-size: 0.95rem;
    }

    .exam-card {
        background: white;
        border-radius: 10px;
        padding: 16px 20px;
        border-left: 4px solid var(--primary);
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform 0.2s;
    }
    
    .exam-card:hover {
        transform: translateX(4px);
    }

    .date-badge {
        background: #e0e7ff;
        color: #4338ca;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 800;
        text-align: center;
        min-width: 130px;
    }
    
    .date-badge .day { font-size: 1.1rem; }
    .date-badge .time { font-size: 0.85rem; font-weight: 600; opacity: 0.9; }

    .exam-info {
        flex-grow: 1;
        margin-left: 20px;
    }
    
    .exam-type {
        font-weight: 800;
        color: #1e293b;
        font-size: 1.1rem;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .exam-meta {
        font-size: 0.9rem;
        color: var(--secondary);
    }
</style>

<div class="container-fluid py-4">
    <div class="page-header-card">
        <div>
            <h1>💯 Not Girişi</h1>
            <p>Aşağıda tamamlanmış veya başlamış sınavlarınız listelenmektedir. Not girmek için seçiniz.</p>
        </div>
        @if (Model.AktifDonem != null)
        {
            <div class="bg-primary bg-opacity-10 text-primary px-4 py-2 rounded-pill fw-medium">
                @Model.AktifDonem.AkademikYil - @Model.AktifDonem.Donem1 Dönemi
            </div>
        }
    </div>

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-3 border-0 d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">⚠️</span>
            <div>@TempData["Hata"]</div>
        </div>
    }

    <div class="exams-wrap">
        @if (!Model.GirisYapilabilirSinavlar.Any())
        {
            <div class="text-center py-5 text-muted glass-card">
                <div class="fs-1 mb-3">📭</div>
                <h5>Sınav Bulunamadı</h5>
                <p>Şu an için not girişi yapılabilecek geçmiş veya aktif bir sınavınız bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="glass-card p-4">
                @foreach (var exam in Model.GirisYapilabilirSinavlar)
                {
                    <div class="exam-card">
                        <div class="d-flex align-items-center w-100">
                            <div class="date-badge">
                                <div class="day">@exam.Baslangic.ToString("dd MMM yyyy")</div>
                                <div class="time mt-1">@exam.Baslangic.ToString("HH:mm") - @exam.Bitis.ToString("HH:mm")</div>
                            </div>
                            
                            <div class="exam-info">
                                <div class="exam-type">@exam.AcilanDers.Ders.DersKodu - @exam.AcilanDers.Ders.DersAdi (@exam.SinavTipi Sınavı)</div>
                                <div class="exam-meta">
                                    Şube: @exam.AcilanDers.SubeNo | Kontenjan: @exam.AcilanDers.Kontenjan
                                </div>
                            </div>
                            
                            <div>
                                <a asp-action="GradeEntryDetail" asp-route-id="@exam.Id" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm">
                                    Öğrencileri Gör / Not Gir
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <hr class="my-4" />

        <div class="page-header-card bg-light mt-2 mb-4" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
            <div>
                <h3 class="mb-1 text-dark" style="font-size: 1.25rem;">📄 Diğer Değerlendirmeler (Quiz, Ödev, Proje)</h3>
                <p class="mb-0 text-muted" style="font-size: 0.9rem;">Sınav programında yer almayan değerlendirmeleriniz için dersinizi ve not türünü seçiniz.</p>
            </div>
        </div>

        @if (!Model.VerilenDersler.Any())
        {
            <div class="text-center py-4 text-muted glass-card">
                <p class="mb-0">Bu dönem verdiğiniz herhangi bir ders bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ders in Model.VerilenDersler)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="glass-card p-4 h-100 d-flex flex-column">
                            <h5 class="fw-bold text-dark mb-1">@ders.Ders.DersKodu</h5>
                            <p class="text-muted small mb-3">@ders.Ders.DersAdi (Şube: @ders.SubeNo)</p>
                            
                            <div class="mt-auto d-flex flex-column gap-2">
                                <a asp-action="GradeEntryDetail" asp-route-acilanDersId="@ders.Id" asp-route-olcmeTuru="Quiz" class="btn btn-outline-primary btn-sm rounded-pill fw-medium">
                                    Quiz Notu Gir
                                </a>
                                <a asp-action="GradeEntryDetail" asp-route-acilanDersId="@ders.Id" asp-route-olcmeTuru="Odev" class="btn btn-outline-success btn-sm rounded-pill fw-medium">
                                    Ödev Notu Gir
                                </a>
                                <a asp-action="GradeEntryDetail" asp-route-acilanDersId="@ders.Id" asp-route-olcmeTuru="Proje" class="btn btn-outline-info btn-sm rounded-pill fw-medium">
                                    Proje Notu Gir
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

