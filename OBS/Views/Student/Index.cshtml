@model OBS.ViewModels.Student.StudentDashboardViewModel
@{
    ViewData["Title"] = "Öğrenci Paneli";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Merhaba, @Model.Ogrenci.Kullanici.Ad @Model.Ogrenci.Kullanici.Soyad! 👋</h2>
            <p class="text-muted mb-0">Öğrenci Numaran: <span class="fw-medium text-dark">@Model.Ogrenci.OgrenciNo</span> | Sınıf: @Model.Ogrenci.Sinif</p>
        </div>
        @if (Model.AktifDonem != null)
        {
            <div class="bg-primary bg-opacity-10 text-primary px-4 py-2 rounded-pill fw-medium">
                📅 @Model.AktifDonem.AkademikYil - @Model.AktifDonem.Donem1 Dönemi
            </div>
        }
        else
        {
            <div class="bg-warning bg-opacity-10 text-warning px-4 py-2 rounded-pill fw-medium">
                ⚠️ Aktif Dönem Bulunamadı
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Danışman Bilgileri -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0 text-primary">
                        <span class="fs-4 me-2">👨‍🏫</span>Danışman Bilgileri
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Danisman != null)
                    {
                        <div class="d-flex flex-column">
                            <span class="text-muted small mb-1">Unvan / Ad Soyad</span>
                            <span class="fw-bold fs-5 mb-3">@Model.Danisman.Unvan @Model.Danisman.Kullanici.Ad @Model.Danisman.Kullanici.Soyad</span>
                            
                            <span class="text-muted small mb-1">İletişim (E-posta)</span>
                            <a href="mailto:@Model.Danisman.Kullanici.Eposta" class="text-decoration-none fw-medium text-primary">
                                ✉️ @Model.Danisman.Kullanici.Eposta
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <span class="fs-1 d-block mb-2">🤷‍♂️</span>
                            <p class="mb-0">Henüz bir danışman atanmamış.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bugünkü Dersler -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-success">
                        <span class="fs-4 me-2">📚</span>Bugünkü Derslerin
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                        @DateTime.Now.ToString("dd MMMM yyyy, dddd")
                    </span>
                </div>
                <div class="card-body p-4">
                    @if (Model.BugunkuDersler.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border-bottom">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th class="fw-medium border-0 rounded-start">Saat</th>
                                        <th class="fw-medium border-0">Ders Kodu</th>
                                        <th class="fw-medium border-0">Ders Adı</th>
                                        <th class="fw-medium border-0 rounded-end">Salon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var program in Model.BugunkuDersler)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">
                                                <span class="badge bg-light text-dark border">
                                                    @program.BaslangicSaati.ToString("HH:mm") - @program.BitisSaati.ToString("HH:mm")
                                                </span>
                                            </td>
                                            <td><span class="fw-medium text-secondary">@program.AcilanDers.Ders.DersKodu</span></td>
                                            <td class="fw-bold">@program.AcilanDers.Ders.DersAdi</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="bg-success bg-opacity-10 text-success p-2 rounded me-2">📍</span>
                                                    <span class="fw-medium">@program.Salon.SalonAdi</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <span class="fs-1">🎉</span>
                            </div>
                            <h5 class="fw-bold text-dark">Bugün Dersin Yok!</h5>
                            <p class="text-muted mb-0">Günün tadını çıkarabilir ya da kütüphaneye gidebilirsin.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
