@model OBS.ViewModels.Student.StudentGradesViewModel
@{
    ViewData["Title"] = "Not Bilgileri";
}

<style>
    :root {
        --primary: #4338ca;
        --secondary: #64748b;
        --card-bg: rgba(255, 255, 255, 0.95);
        --muted: #94a3b8;
    }
    
    .grades-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 15px;
    }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        padding: 24px;
    }

    .page-header-card {
        background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
        border-radius: 16px;
        padding: 24px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    .page-header-card h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 5px 0;
    }
    
    .page-header-card p {
        margin: 0;
        color: var(--secondary);
        font-size: 0.95rem;
    }

    .course-grade-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border-left: 4px solid var(--primary);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        margin-bottom: 15px;
        transition: transform 0.2s;
    }
    .course-grade-card:hover {
        transform: translateY(-3px);
    }

    .course-title {
        font-weight: 800;
        color: #1e293b;
        font-size: 1.2rem;
        margin-bottom: 5px;
    }
    
    .course-meta {
        font-size: 0.9rem;
        color: var(--secondary);
        margin-bottom: 15px;
    }

    .grades-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 15px;
    }

    .grade-item {
        background: #f8fafc;
        border-radius: 8px;
        padding: 12px 15px;
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
    }

    .grade-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .grade-score {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--primary);
    }

    .empty-state {
        text-align: center;
        padding: 30px;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px dashed #cbd5e1;
    }
</style>

<div class="container-fluid py-4">
    <div class="page-header-card">
        <div>
            <h1>📊 Not Bilgileri</h1>
            <p>Bu dönem aldığınız derslere ait sınav ve değerlendirme notlarınız.</p>
        </div>
        @if (Model.AktifDonem != null)
        {
            <div class="bg-primary bg-opacity-10 text-primary px-4 py-2 rounded-pill fw-medium">
                @Model.AktifDonem.AkademikYil - @Model.AktifDonem.Donem1 Dönemi
            </div>
        }
    </div>

    <div class="grades-wrap">
        @if (!Model.DersKayitlari.Any())
        {
            <div class="text-center py-5 text-muted glass-card">
                <div class="fs-1 mb-3">📭</div>
                <h5>Kayıtlı Ders Bulunamadı</h5>
                <p>Bu döneme ait onaylanmış bir ders kaydınız bulunmamaktadır.</p>
            </div>
        }
        else
        {
            foreach (var kayit in Model.DersKayitlari)
            {
                <div class="course-grade-card">
                    <div class="course-title">@kayit.AcilanDers.Ders.DersKodu - @kayit.AcilanDers.Ders.DersAdi</div>
                    <div class="course-meta">
                        👨‍🏫 @kayit.AcilanDers.OgretimUyesi.Unvan @kayit.AcilanDers.OgretimUyesi.Kullanici.Ad @kayit.AcilanDers.OgretimUyesi.Kullanici.Soyad 
                        <span class="mx-2">|</span> 
                        🎯 @kayit.AcilanDers.Ders.Kredi Kredi / @kayit.AcilanDers.Ders.Akts AKTS
                    </div>
                    
                    @if (kayit.Notlars.Any())
                    {
                        var sortOrder = new List<string> { "Vize", "Quiz", "Odev", "Proje", "Final", "Butunleme" };
                        
                        <div class="grades-grid">
                            @foreach (var not in kayit.Notlars.OrderBy(n => sortOrder.IndexOf(n.OlcmeTuru) != -1 ? sortOrder.IndexOf(n.OlcmeTuru) : 999))
                            {
                                <div class="grade-item">
                                    <div class="grade-label">@not.OlcmeTuru</div>
                                    <div class="grade-score">
                                        @not.Puan.ToString("0.##")
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="text-muted mb-1">⏳</div>
                            <div class="small fw-medium text-secondary">Henüz not girilmemiş</div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
