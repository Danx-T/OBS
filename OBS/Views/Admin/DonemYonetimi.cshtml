@model List<OBS.Models.Donem>
@{
    ViewData["Title"] = "Dönem Yönetimi";
    var simdi = DateTime.Now;
    var aktifKayitDonemi = Model.FirstOrDefault(d => simdi >= d.DersKaydiBaslangic && simdi <= d.DersKaydiBitis);
}

<style>
    :root {
        --primary:      #2563eb;
        --primary-dark: #1e40af;
        --success:      #10b981;
        --danger:       #ef4444;
        --warning:      #f59e0b;
        --muted:        #64748b;
    }

    /* ── WRAPPER ── */
    .donem-wrap {
        max-width: 1300px;
        margin: 36px auto;
        padding: 0 20px 80px;
        font-family: 'Outfit', 'Inter', 'Segoe UI', sans-serif;
    }

    /* ── HEADER ── */
    .donem-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }

    .donem-title h1 {
        font-size: 1.65rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .donem-title p {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 4px 0 0;
    }

    /* ── STAT PILLS ── */
    .stats-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.82rem;
    }

    .stat-pill.blue   { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .stat-pill.green  { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .stat-pill.orange { background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }

    /* ── GLASS CARD ── */
    .panel-card {
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(12px);
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .panel-header .panel-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cnt-badge {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 10px;
    }

    /* ── TABLE ── */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-custom th {
        background: #f8fafc;
        padding: 14px 16px;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .table-custom td {
        padding: 14px 16px;
        font-size: 0.88rem;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .table-custom tr:last-child td { border-bottom: none; }
    .table-custom tr:hover td { background: #f8fafc; transition: background 0.12s; }

    /* ── TYPE BADGES ── */
    .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 9px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .type-badge.guz   { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .type-badge.bahar { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .type-badge.yaz   { background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }

    /* ── STATUS DOT / BADGE ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.73rem;
        font-weight: 700;
    }

    .status-badge.aktif { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .status-badge.gecmis { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .status-badge.gelecek { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }

    .dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .dot.aktif   { background: #10b981; }
    .dot.gecmis  { background: #94a3b8; }
    .dot.gelecek { background: #3b82f6; }

    /* ── KOD CHIP ── */
    .yil-chip {
        font-family: 'Fira Code', monospace;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 8px;
        background: #f8fafc;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        display: inline-block;
    }

    /* ── ACTION BUTTONS ── */
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.78rem;
        border: none;
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-danger-soft {
        background: #fff1f2;
        color: #be123c;
        border: 1px solid #fecdd3;
    }

    .btn-danger-soft:hover {
        background: #ef4444;
        color: #fff;
        border-color: #ef4444;
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 48px 20px;
        color: var(--muted);
    }

    .empty-state .icon { font-size: 2.8rem; margin-bottom: 10px; }
    .empty-state p { font-size: 0.9rem; margin: 0; }

    @@media (max-width: 992px) {
        .donem-wrap { padding: 0 12px 60px; }
        .table-custom th:nth-child(3),
        .table-custom td:nth-child(3) { display: none; }
    }
</style>

<div class="donem-wrap">

    <!-- HEADER -->
    <div class="donem-header">
        <div class="donem-title">
            <h1>📅 Dönem Yönetimi</h1>
            <p>Akademik takvim dönemlerini ve ders kayıt zaman aralıklarını tanımlayıp yönetin.</p>
        </div>
        <div class="stats-row">
            <span class="stat-pill blue">📅 Toplam Dönem: @Model.Count</span>
            @if (aktifKayitDonemi != null)
            {
                <span class="stat-pill green">
                    🟢 Aktif Kayıt Dönemi: @aktifKayitDonemi.AkademikYil @(aktifKayitDonemi.Donem1 == "Guz" ? "Güz" : aktifKayitDonemi.Donem1)
                </span>
            }
            else
            {
                <span class="stat-pill orange">
                    ⚠️ Şu An Açık Ders Kayıt Dönemi Yok
                </span>
            }
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert" style="border-radius:12px;">
            <strong>✓ Başarılı:</strong> @TempData["Basari"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert" style="border-radius:12px;">
            <strong>✕ Hata:</strong> @TempData["Hata"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ═══════════════════════════════════
             SOL: Mevcut Dönemler Tablosu (8 Kolon)
        ═══════════════════════════════════ -->
        <div class="col-lg-8">
            <div class="panel-card">
                <div class="panel-header">
                    <span class="panel-title">📚 Tanımlı Akademik Dönemler</span>
                    <span class="cnt-badge">@Model.Count</span>
                </div>

                <div>
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <div class="icon">📅</div>
                            <p>Henüz sistemde tanımlı akademik dönem bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table-custom">
                                <thead>
                                    <tr>
                                        <th>Akademik Yıl</th>
                                        <th>Dönem</th>
                                        <th>Dönem Tarihleri</th>
                                        <th>Ders Kayıt Aralığı</th>
                                        <th>Açılan Ders</th>
                                        <th>Durum</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model)
                                    {
                                        string bdgClass = d.Donem1.ToLower() switch
                                        {
                                            var t when t.Contains("güz") || t.Contains("guz") => "guz",
                                            var t when t.Contains("bahar") => "bahar",
                                            _ => "yaz"
                                        };

                                        bool kayitAcik = simdi >= d.DersKaydiBaslangic && simdi <= d.DersKaydiBitis;
                                        bool gelecekMi = simdi < d.DersKaydiBaslangic;

                                        string stClass = kayitAcik ? "aktif" : (gelecekMi ? "gelecek" : "gecmis");
                                        string stText  = kayitAcik ? "Kayıtlar Açık" : (gelecekMi ? "Yaklaşan Dönem" : "Kapandı / Geçmiş");

                                        <tr>
                                            <td>
                                                <span class="yil-chip">@d.AkademikYil</span>
                                            </td>
                                            <td>
                                                <span class="type-badge @bdgClass">@(d.Donem1 == "Guz" ? "Güz" : d.Donem1)</span>
                                            </td>
                                            <td>
                                                <div class="small fw-600 text-dark">@d.BaslangicTarihi.ToString("dd.MM.yyyy")</div>
                                                <div class="small text-muted" style="font-size:0.75rem;">@d.BitisTarihi.ToString("dd.MM.yyyy")</div>
                                            </td>
                                            <td>
                                                <div class="small fw-600 text-dark">@d.DersKaydiBaslangic.ToString("dd.MM.yyyy HH:mm")</div>
                                                <div class="small text-muted" style="font-size:0.75rem;">@d.DersKaydiBitis.ToString("dd.MM.yyyy HH:mm")</div>
                                            </td>
                                            <td>
                                                <span class="cnt-badge">@d.AcilanDers.Count</span>
                                            </td>
                                            <td>
                                                <span class="status-badge @stClass">
                                                    <span class="dot @stClass"></span>
                                                    @stText
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <a asp-action="DonemDuzenle" asp-route-id="@d.Id" class="btn-action" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">
                                                        ✏️ Düzenle
                                                    </a>
                                                    <form asp-action="DonemSil" asp-controller="Admin" method="post" class="m-0"
                                                          onsubmit="return confirm('@d.AkademikYil @d.Donem1 dönemini silmek istediğinize emin misiniz?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@d.Id" />
                                                        <button type="submit" class="btn-action btn-danger-soft">
                                                            🗑️ Sil
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════
             SAĞ: Yeni Dönem Ekleme Formu
        ═══════════════════════════════════ -->
        <div class="col-lg-4">
            <div class="panel-card">
                <div class="panel-header">
                    <span class="panel-title">➕ Yeni Akademik Dönem Oluştur</span>
                </div>
                <div class="p-4">
                    <form asp-action="DonemEkle" asp-controller="Admin" method="post" id="donemEkleForm">
                        @Html.AntiForgeryToken()

                        <!-- Akademik Yıl -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted mb-1">Akademik Yıl <span class="text-danger">*</span></label>
                            <input type="text" name="akademikYil" class="form-control"
                                   placeholder="ör: 2025-2026" required id="akademikYilInput"
                                   maxlength="9" />
                            <div class="form-text small" style="font-size:0.75rem;">Format: YYYY-YYYY (ör: 2025-2026)</div>
                            <div id="donemHint" style="font-size:0.78rem; margin-top:4px; min-height:18px;"></div>
                        </div>

                        <!-- Dönem -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted mb-1">Dönem <span class="text-danger">*</span></label>
                            <select name="donem1" class="form-select" id="donemSelect" required>
                                <option value="Güz">Güz</option>
                                <option value="Bahar">Bahar</option>
                                <option value="Yaz">Yaz</option>
                            </select>
                        </div>

                        <hr class="border-secondary-subtle my-3" />
                        <div class="small fw-bold text-uppercase text-muted mb-2" style="font-size:0.72rem; letter-spacing:0.05em;">
                            📅 Eğitim - Öğretim Tarihleri
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Başlangıç</label>
                                <input type="date" name="baslangicTarihi" class="form-control form-control-sm" required id="baslangicTarihInput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Bitiş</label>
                                <input type="date" name="bitisTarihi" class="form-control form-control-sm" required id="bitisTarihInput" />
                            </div>
                        </div>

                        <hr class="border-secondary-subtle my-3" />
                        <div class="small fw-bold text-uppercase text-muted mb-2" style="font-size:0.72rem; letter-spacing:0.05em;">
                            ⏰ Ders Kayıt Zaman Aralığı
                        </div>

                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Kayıt Başlangıç Tarih & Saat</label>
                            <input type="datetime-local" name="dersKaydiBaslangic" class="form-control form-control-sm" required id="kayitBaslangicInput" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label small text-muted mb-1">Kayıt Bitiş Tarih & Saat</label>
                            <input type="datetime-local" name="dersKaydiBitis" class="form-control form-control-sm" required id="kayitBitisInput" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2" id="donemEkleBtn">
                            ➕ Dönemi Kaydet
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    const YIL_REGEX = /^\d{4}-\d{4}$/;
    const yilInput  = document.getElementById('akademikYilInput');
    const donemSel  = document.getElementById('donemSelect');
    const submitBtn = document.getElementById('donemEkleBtn');
    const hint      = document.getElementById('donemHint');

    if (!yilInput || !donemSel || !submitBtn) return;

    // Varsayılan tarihleri güncel döneme göre rahatlık olması için ayarla
    const bugun = new Date();
    const yil   = bugun.getFullYear();
    const ay    = bugun.getMonth() + 1;

    if (!yilInput.value) {
        if (ay >= 8) {
            yilInput.value = yil + "-" + (yil + 1);
            donemSel.value = "Güz";
        } else {
            yilInput.value = (yil - 1) + "-" + yil;
            donemSel.value = "Bahar";
        }
    }

    let debounceTimer = null;
    let gecerli = true;

    function kontrolEt() {
        const yVal = yilInput.value.trim();
        const dVal = donemSel.value;

        if (yVal === '') {
            hint.textContent = '';
            yilInput.style.borderColor = '';
            gecerli = true;
            submitBtn.disabled = false;
            return;
        }

        if (!YIL_REGEX.test(yVal)) {
            hint.style.color = '#dc2626';
            hint.textContent = '✗ Format YYYY-YYYY olmalı (ör: 2025-2026)';
            yilInput.style.borderColor = '#ef4444';
            gecerli = false;
            submitBtn.disabled = true;
            return;
        }

        const parcalar = yVal.split('-');
        const bas = parseInt(parcalar[0], 10);
        const bit = parseInt(parcalar[1], 10);
        if (bit !== bas + 1) {
            hint.style.color = '#dc2626';
            hint.textContent = '✗ İkinci yıl ilk yıldan tam 1 fazla olmalıdır (ör: 2025-2026)';
            yilInput.style.borderColor = '#ef4444';
            gecerli = false;
            submitBtn.disabled = true;
            return;
        }

        hint.style.color = '#64748b';
        hint.textContent = '⏳ Kontrol ediliyor…';
        yilInput.style.borderColor = '';
        submitBtn.disabled = true;

        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            fetch('/Admin/DonemKontrol?akademikYil=' + encodeURIComponent(yVal) + '&donem1=' + encodeURIComponent(dVal))
                .then(r => r.json())
                .then(data => {
                    if (data.kullanildi) {
                        hint.style.color = '#dc2626';
                        hint.textContent = '✗ "' + yVal + ' ' + dVal + '" dönemi sistemde zaten var.';
                        yilInput.style.borderColor = '#ef4444';
                        gecerli = false;
                        submitBtn.disabled = true;
                    } else {
                        hint.style.color = '#059669';
                        hint.textContent = '✓ "' + yVal + ' ' + dVal + '" dönemi eklenebilir.';
                        yilInput.style.borderColor = '#10b981';
                        gecerli = true;
                        submitBtn.disabled = false;
                    }
                })
                .catch(() => {
                    hint.style.color = '#92400e';
                    hint.textContent = '⚠ Kontrol edilemedi; devam edebilirsiniz.';
                    yilInput.style.borderColor = '#f59e0b';
                    gecerli = true;
                    submitBtn.disabled = false;
                });
        }, 350);
    }

    yilInput.addEventListener('input', kontrolEt);
    donemSel.addEventListener('change', kontrolEt);

    // Form submit esnasında tarih aralıklarını doğrula
    document.getElementById('donemEkleForm').addEventListener('submit', function (e) {
        if (!gecerli) {
            e.preventDefault();
            alert('Lütfen geçerli ve kullanılabilir bir Akademik Yıl girin.');
            return;
        }

        const bas = document.getElementById('baslangicTarihInput').value;
        const bit = document.getElementById('bitisTarihInput').value;
        if (bas && bit && bas >= bit) {
            e.preventDefault();
            alert('Dönem başlangıç tarihi bitiş tarihinden sonra veya aynı olamaz.');
            return;
        }

        const kBas = document.getElementById('kayitBaslangicInput').value;
        const kBit = document.getElementById('kayitBitisInput').value;
        if (kBas && kBit && kBas >= kBit) {
            e.preventDefault();
            alert('Ders kaydı başlangıç tarihi bitiş tarihinden sonra veya aynı olamaz.');
            return;
        }
    });

    // Sayfa açıldığında otomatik kontrolü başlat
    setTimeout(kontrolEt, 100);

})();
</script>
}
