@model List<OBS.ViewModels.DanismanAtamaViewModel>
@{
    ViewData["Title"] = "Akademik Danışman Atama";
    var bolumId = ViewBag.SeciliBolumId as int?;
    var arama = ViewBag.Arama as string;
    var atanmayanSayisi = Model.Count(m => !m.DanismanId.HasValue);
}

<style>
    .danisman-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .danisman-title h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }
    .danisman-title p {
        color: #64748b;
        font-size: 0.9rem;
        margin: 4px 0 0 0;
    }
    .stats-bar {
        display: flex;
        gap: 16px;
    }
    .stat-badge {
        padding: 10px 16px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .stat-badge.total {
        background: #f1f5f9;
        color: #334155;
    }
    .stat-badge.warning {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }
    .filter-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        margin-bottom: 24px;
        border: 1px solid #e2e8f0;
    }
    .filter-form {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }
    .filter-form .form-group {
        flex: 1;
        min-width: 200px;
        margin: 0;
    }
    .filter-form .btn-filter {
        height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        background: #4f46e5;
        color: #fff;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .filter-form .btn-filter:hover {
        background: #4338ca;
    }
    .filter-form .btn-reset {
        height: 42px;
        padding: 0 16px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #64748b;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        font-weight: 600;
        transition: all 0.2s;
    }
    .filter-form .btn-reset:hover {
        background: #e2e8f0;
        color: #334155;
    }
    .toplu-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(90deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 14px 24px;
        border-radius: 14px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
    }
    .toplu-bar-text {
        font-weight: 600;
        font-size: 0.95rem;
    }
    .btn-toplu-kaydet {
        background: #ffffff;
        color: #065f46;
        border: none;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.2s, background 0.2s;
    }
    .btn-toplu-kaydet:hover {
        background: #f0fdf4;
        transform: translateY(-1px);
    }
    .table-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }
    .table-modern {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .table-modern th {
        background: #f8fafc;
        padding: 14px 20px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
    }
    .table-modern td {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        vertical-align: middle;
    }
    .table-modern tbody tr:hover {
        background: #f8fafc;
    }
    .badge-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }
    .badge-assigned {
        background: #dcfce7;
        color: #15803d;
    }
    .badge-unassigned {
        background: #fee2e2;
        color: #b91c1c;
    }
    .assign-select {
        width: 100%;
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        font-size: 0.85rem;
    }
    .danisman-wrap {
        max-width: 1350px;
        margin: 36px auto;
        padding: 0 20px 60px;
    }
</style>

<div class="danisman-wrap">
    <div class="danisman-header">
    <div class="danisman-title">
        <h1>👨‍🏫 Akademik Danışman Atama & Yönetimi</h1>
        <p>Öğrencilerin akademik danışmanlarını bu ekrandan toplu olarak atayabilir veya değiştirebilirsiniz.</p>
    </div>
    <div class="stats-bar">
        <div class="stat-badge total">
            <span>🎓</span> Toplam Öğrenci: <strong>@Model.Count</strong>
        </div>
        @if (atanmayanSayisi > 0)
        {
            <div class="stat-badge warning">
                <span>⚠️</span> Danışmansız Öğrenci: <strong>@atanmayanSayisi</strong>
            </div>
        }
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px; margin-bottom: 20px;">
        ✅ @TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 12px; margin-bottom: 20px;">
        ❌ @TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.HocaListesi != null && ViewBag.HocaListesi.Count == 0)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" style="border-radius: 12px; margin-bottom: 20px;">
        ⚠️ <strong>Uyarı:</strong> Sistemde şu anda <strong>"Danışman"</strong> rolüne sahip hiçbir öğretim üyesi bulunmuyor. Bu nedenle listede atama yapılacak hoca gözükmez. Danışman ataması yapabilmek için önce <a asp-action="KullaniciYetkilendirme" asp-controller="Admin" class="alert-link">Kullanıcı Yetkileri</a> ekranından ilgili öğretim üyelerine <strong>Danışman</strong> rolünü veriniz.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="filter-card">
    <form method="get" asp-action="DanismanAtama" class="filter-form">
        <div class="form-group">
            <select name="bolumId" asp-items="ViewBag.Bolumler" class="form-select">
                <option value="">Tüm Bölümler / Programlar</option>
            </select>
        </div>
        <div class="form-group">
            <input type="text" name="arama" value="@arama" class="form-control" placeholder="Öğrenci No, Ad veya Soyad ile ara..." autocomplete="off" />
        </div>
        <button type="submit" class="btn-filter">🔍 Filtrele</button>
        <a asp-action="DanismanAtama" class="btn-reset">Sıfırla</a>
    </form>
</div>

<form asp-action="TopluDanismanAta" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bolumId" value="@bolumId" />
    <input type="hidden" name="arama" value="@arama" />

    @if (Model.Any())
    {
        <div class="toplu-bar">
            <div class="toplu-bar-text">
                ⚡ Listede istediğiniz öğrencilerin danışmanlarını seçtikten sonra tek tıkla topluca kaydedin.
            </div>
            <button type="submit" class="btn-toplu-kaydet">💾 TÜM DEĞİŞİKLİKLERİ KAYDET</button>
        </div>
    }

    <div class="table-card">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>ÖĞRENCİ NO</th>
                    <th>AD SOYAD</th>
                    <th>BÖLÜM</th>
                    <th>SINIF</th>
                    <th>MEVCUT DURUM</th>
                    <th style="width: 380px;">DANIŞMAN SEÇİMİ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var ogrenci in Model)
                    {
                        <tr>
                            <td>
                                <strong>@ogrenci.OgrenciNo</strong>
                                <input type="hidden" name="ogrenciId" value="@ogrenci.OgrenciId" />
                            </td>
                            <td>@ogrenci.AdSoyad</td>
                            <td>@ogrenci.BolumAdi</td>
                            <td>@ogrenci.Sinif .Sınıf</td>
                            <td>
                                @if (!string.IsNullOrEmpty(ogrenci.DanismanAdSoyad))
                                {
                                    <span class="badge-status badge-assigned">👨‍🏫 @ogrenci.DanismanAdSoyad</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-unassigned">⚠️ Atanmadı</span>
                                }
                            </td>
                            <td>
                                <select name="danismanId" class="assign-select">
                                    <option value="">-- Danışman Yok (Kaldır) --</option>
                                    @foreach (var hoca in ViewBag.HocaListesi)
                                    {
                                        var isSelected = ogrenci.DanismanId == hoca.Id;
                                        <option value="@hoca.Id" selected="@isSelected">
                                            @hoca.AdSoyad (@hoca.BolumAdi)
                                        </option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: #64748b;">
                            Aranan kriterlere uygun öğrenci bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Any() && Model.Count > 5)
    {
        <div style="text-align: right; margin-top: 16px;">
            <button type="submit" class="btn-toplu-kaydet" style="background: #10b981; color: white;">💾 TÜM DEĞİŞİKLİKLERİ KAYDET</button>
        </div>
    }
</form>
</div>
