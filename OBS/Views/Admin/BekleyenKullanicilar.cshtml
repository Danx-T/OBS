@model IEnumerable<OBS.Models.Kullanici>
@{
    ViewData["Title"] = "Onay Bekleyen Kullanıcılar";
}

<style>
    :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --danger: #dc2626;
        --danger-dark: #b91c1c;
        --success: #16a34a;
        --bg: #f1f5f9;
        --card-bg: #ffffff;
        --text: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    body {
        background: var(--bg);
        font-family: 'Inter', 'Segoe UI', sans-serif;
        color: var(--text);
    }

    .admin-wrapper {
        max-width: 1000px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .admin-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 32px;
    }

    .admin-header .icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, var(--primary), #7c3aed);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(37,99,235,0.3);
    }

    .admin-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
        color: var(--text);
    }

    .admin-header p {
        margin: 2px 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .alert-custom {
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 24px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-success-custom {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: var(--success);
    }

    .alert-danger-custom {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--danger);
    }

    .empty-state {
        background: var(--card-bg);
        border-radius: 16px;
        padding: 60px 40px;
        text-align: center;
        box-shadow: var(--shadow);
    }

    .empty-state .emoji {
        font-size: 3.5rem;
        margin-bottom: 16px;
    }

    .empty-state h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--text);
    }

    .empty-state p {
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .user-card {
        background: var(--card-bg);
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 16px;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        border: 1px solid var(--border);
    }

    .user-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    }

    .user-avatar {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        font-weight: 700;
        color: white;
        flex-shrink: 0;
    }

    .user-info {
        flex: 1;
        min-width: 0;
    }

    .user-info .name {
        font-weight: 600;
        font-size: 1rem;
        color: var(--text);
        margin-bottom: 2px;
    }

    .user-info .email {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-bottom: 4px;
    }

    .user-info .meta {
        color: #94a3b8;
        font-size: 0.78rem;
    }

    .badge-pending {
        background: #fef9c3;
        color: #854d0e;
        border: 1px solid #fde68a;
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .user-actions {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }

    .btn-approve {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: white;
        border: none;
        padding: 9px 20px;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s ease, transform 0.1s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-approve:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    .btn-reject {
        background: white;
        color: var(--danger);
        border: 1.5px solid #fecaca;
        padding: 9px 20px;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease, transform 0.1s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-reject:hover {
        background: #fef2f2;
        transform: translateY(-1px);
    }

    .count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ef4444;
        color: white;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        margin-left: 8px;
    }

    @@media (max-width: 600px) {
        .user-card {
            flex-direction: column;
            align-items: flex-start;
        }
        .user-actions {
            width: 100%;
        }
        .btn-approve, .btn-reject {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="admin-wrapper">
    <div class="admin-header">
        <div class="icon">🛡️</div>
        <div>
            <h1>
                Onay Bekleyen Kullanıcılar
                @if (Model.Any())
                {
                    <span class="count-badge">@Model.Count()</span>
                }
            </h1>
            <p>Kayıt olan ve admin onayı bekleyen hesaplar</p>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert-custom alert-success-custom">
            ✅ @TempData["Basari"]
        </div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert-custom alert-danger-custom">
            ❌ @TempData["Hata"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="emoji">🎉</div>
            <h3>Onay bekleyen kullanıcı yok</h3>
            <p>Tüm kayıtlar işlendi.</p>
        </div>
    }
    else
    {
        @foreach (var kullanici in Model)
        {
            var initials = (kullanici.Ad.Length > 0 ? kullanici.Ad[0].ToString() : "") +
                           (kullanici.Soyad.Length > 0 ? kullanici.Soyad[0].ToString() : "");

            <div class="user-card">
                <div class="user-avatar">@initials</div>
                <div class="user-info">
                    <div class="name">@kullanici.Ad @kullanici.Soyad</div>
                    <div class="email">📧 @kullanici.Eposta</div>
                    <div class="meta">
                        📱 @kullanici.Telefon &nbsp;•&nbsp;
                        🗓 @kullanici.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
                <span class="badge-pending">⏳ Onay Bekliyor</span>
                <div class="user-actions">
                    <form asp-action="KullaniciOnayla" asp-route-id="@kullanici.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-approve">✔ Onayla</button>
                    </form>
                    <form asp-action="KullaniciReddet" asp-route-id="@kullanici.Id" method="post" style="display:inline;"
                          onsubmit="return confirm('@kullanici.Ad @kullanici.Soyad adlı kullanıcıyı silmek istediğinizden emin misiniz?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-reject">✖ Reddet</button>
                    </form>
                </div>
            </div>
        }
    }
</div>
