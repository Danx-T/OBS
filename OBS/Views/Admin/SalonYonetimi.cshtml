@model List<OBS.Models.Salon>
@{
    ViewData["Title"] = "Bina ve Derslik Yönetimi";
    var binalar = ViewBag.Binalar as List<OBS.Models.Salon> ?? new List<OBS.Models.Salon>();
    int? seciliBinaId = ViewBag.SeciliBinaId as int?;
    string? arama = ViewBag.Arama as string;
}

<style>
    :root {
        --primary:      #2563eb;
        --primary-dark: #1e40af;
        --success:      #10b981;
        --danger:       #ef4444;
        --warning:      #f59e0b;
        --surface:      #ffffff;
        --border:       #e2e8f0;
        --text:         #0f172a;
        --muted:        #64748b;
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .salon-wrap {
        padding: 0 24px 60px;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* HEADER */
    .page-header-card {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 20px;
        padding: 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.25);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header-card h1 {
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
    }

    .page-header-card p {
        margin: 0;
        opacity: 0.85;
        font-size: 0.95rem;
    }

    .stats-badge-group {
        display: flex;
        gap: 12px;
    }

    .stat-pill {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        padding: 10px 18px;
        border-radius: 12px;
        text-align: center;
    }

    .stat-pill .num {
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-pill .lbl {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.8;
        margin-top: 4px;
    }

    /* PANELS */
    .panel-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        height: 100%;
    }

    .panel-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fcfcfc;
    }

    .panel-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text);
        margin: 0;
    }

    /* FILTER BAR */
    .filter-bar {
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
        padding: 14px 20px;
    }

    /* TABLE */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-custom th {
        background: #f8fafc;
        color: var(--muted);
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
    }

    .table-custom td {
        padding: 14px 18px;
        vertical-align: middle;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        font-size: 0.92rem;
    }

    .table-custom tr:hover td {
        background: #f8fafc;
    }

    .row-bina {
        background-color: #f1f5f9;
        font-weight: 600;
    }

    /* BADGES */
    .type-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        border: 1px solid transparent;
    }
    .type-badge.bina { background: #e0e7ff; color: #4338ca; border-color: #c7d2fe; }
    .type-badge.derslik { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }
    .type-badge.amfi { background: #ffedd5; color: #c2410c; border-color: #fed7aa; }
    .type-badge.laboratuvar { background: #fce7f3; color: #be185d; border-color: #fbcfe8; }
    .type-badge.toplantiodasi { background: #fdf4ff; color: #a21caf; border-color: #fae8ff; }
    .type-badge.diger { background: #f3f4f6; color: #4b5563; border-color: #e5e7eb; }

    /* BUTTONS */
    .btn-action {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: all 0.2s;
        cursor: pointer;
    }
    .btn-danger-soft {
        background: #fef2f2;
        color: var(--danger);
        border-color: #fee2e2;
    }
    .btn-danger-soft:hover { background: var(--danger); color: white; }

    .nav-tabs .nav-link {
        font-weight: 600;
        color: var(--muted);
        border-radius: 8px 8px 0 0;
        padding: 12px 20px;
    }
    .nav-tabs .nav-link.active {
        color: var(--primary);
        border-bottom-color: transparent;
    }
</style>

<div class="salon-wrap">

    <div class="page-header-card">
        <div>
            <h1>🏢 Bina ve Derslik Yönetimi</h1>
            <p>Fakülte binalarını, sınıfları, amfileri ve laboratuvarları sisteme ekleyin.</p>
        </div>
        <div class="stats-badge-group">
            <div class="stat-pill">
                <div class="num">@binalar.Count</div>
                <div class="lbl">Bina</div>
            </div>
            <div class="stat-pill">
                <div class="num text-warning">@(Model.Count - binalar.Count(b => Model.Any(m => m.Id == b.Id)))</div>
                <div class="lbl">Salon / Derslik</div>
            </div>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="border-radius:12px; background:#ecfdf5; color:#065f46;">
            <span class="fs-5 me-2">✓</span>
            <div>@TempData["Basari"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="border-radius:12px; background:#fef2f2; color:#991b1b;">
            <span class="fs-5 me-2">✕</span>
            <div>@TempData["Hata"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- SOL: Liste -->
        <div class="col-lg-8">
            <div class="panel-card">
                <div class="panel-header">
                    <span class="panel-title">📍 Mevcut Binalar ve Salonlar</span>
                    <span class="badge bg-light text-dark border font-monospace">@Model.Count Kayıt</span>
                </div>

                <div class="filter-bar">
                    <form asp-action="SalonYonetimi" asp-controller="Admin" method="get" class="d-flex flex-wrap gap-2 w-100 m-0">
                        <select name="binaId" class="form-select form-select-sm" style="max-width:220px;" onchange="this.form.submit();">
                            <option value="">-- Tüm Binaları Göster --</option>
                            @foreach (var b in binalar)
                            {
                                if (seciliBinaId == b.Id)
                                {
                                    <option value="@b.Id" selected>@b.SalonAdi</option>
                                }
                                else
                                {
                                    <option value="@b.Id">@b.SalonAdi</option>
                                }
                            }
                        </select>

                        <div class="input-group input-group-sm" style="max-width:210px;">
                            <input type="text" name="arama" class="form-control" placeholder="Salon Adı veya Tipi..." value="@arama" />
                            <button type="submit" class="btn btn-outline-secondary">🔍</button>
                        </div>

                        @if (seciliBinaId.HasValue || !string.IsNullOrWhiteSpace(arama))
                        {
                            <a asp-action="SalonYonetimi" asp-controller="Admin" class="btn btn-sm btn-outline-danger d-flex align-items-center">
                                ✕ Temizle
                            </a>
                        }
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Adı / Kodu</th>
                                <th>Bağlı Olduğu Bina</th>
                                <th>Tip</th>
                                <th>Kapasite</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        @if (!Model.Any())
                        {
                            <tbody>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Kayıt bulunamadı.</td>
                                </tr>
                            </tbody>
                        }
                        
                        @{
                            // Ekranda gösterilecek binaları bulalım
                            var ekrandakiBinalar = binalar
                                .Where(b => Model.Any(m => m.Id == b.Id || m.BinaId == b.Id))
                                .OrderBy(b => b.SalonAdi)
                                .ToList();
                        }
                        
                        @foreach (var bina in ekrandakiBinalar)
                        {
                            var altSalonlar = Model.Where(m => m.BinaId == bina.Id).OrderBy(m => m.SalonAdi).ToList();
                            
                            <!-- BİNA SATIRI (TIKLANABİLİR) -->
                            <tbody style="border-top: none;">
                                <tr class="row-bina" data-bs-toggle="collapse" data-bs-target="#bina-@bina.Id" style="cursor: pointer; transition: background 0.2s;" title="İçindeki salonları görmek için tıklayın">
                                    <td>
                                        <span class="fs-6 me-1">🏢</span>
                                        <span class="fw-bold text-dark">@bina.SalonAdi</span>
                                        @if (altSalonlar.Any())
                                        {
                                            <span class="badge bg-secondary ms-2" style="font-size:0.7rem; font-weight:500;">@altSalonlar.Count Salon</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted">—</span>
                                    </td>
                                    <td>
                                        <span class="type-badge bina">Bina</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">—</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end">
                                            <button type="button" class="btn-action text-decoration-none" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;" title="Düzenle" onclick="event.stopPropagation(); window.location.href='@Url.Action("SalonDuzenle", "Admin", new { id = bina.Id })';">
                                                ✏️
                                            </button>
                                            <form asp-action="SalonSil" asp-controller="Admin" method="post" class="m-0"
                                                  onsubmit="event.stopPropagation(); return confirm('@(bina.SalonAdi) binasını silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@bina.Id" />
                                                <input type="hidden" name="geriDonBinaId" value="@seciliBinaId" />
                                                <button type="submit" class="btn-action btn-danger-soft" title="Sil" onclick="event.stopPropagation();">
                                                    🗑️
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                            
                            <!-- ALT SALONLAR -->
                            if (altSalonlar.Any())
                            {
                                // Eğer arama yapılmışsa veya tek bir bina seçilmişse (seciliBinaId != null) listeler default açık gelsin.
                                string showClass = (!string.IsNullOrWhiteSpace(arama) || seciliBinaId.HasValue) ? "show" : "";
                                
                                <tbody id="bina-@bina.Id" class="collapse @showClass" style="border-top: none;">
                                    @foreach(var s in altSalonlar)
                                    {
                                        string typeClass = s.SalonTipi.ToLower() switch
                                        {
                                            "bina" => "bina",
                                            "sinif" => "derslik",
                                            "amfi" => "amfi",
                                            "laboratuvar" => "laboratuvar",
                                            "toplanti salonu" => "toplantiodasi",
                                            _ => "diger"
                                        };

                                        <tr>
                                            <td>
                                                <span class="fs-6 me-1" style="opacity: 0.35; padding-left: 20px;">↳</span>
                                                <span class="fw-bold text-dark">@s.SalonAdi</span>
                                            </td>
                                            <td>
                                                <span class="small text-muted">@bina.SalonAdi</span>
                                            </td>
                                            <td>
                                                <span class="type-badge @typeClass">@s.SalonTipi</span>
                                            </td>
                                            <td>
                                                @if (s.Kapasite.HasValue)
                                                {
                                                    <span class="fw-bold">@s.Kapasite</span> <span class="small text-muted">Kişi</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1 justify-content-end">
                                                    <a asp-action="SalonDuzenle" asp-route-id="@s.Id" class="btn-action text-decoration-none" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;" title="Düzenle">
                                                        ✏️
                                                    </a>
                                                    <form asp-action="SalonSil" asp-controller="Admin" method="post" class="m-0"
                                                          onsubmit="return confirm('@(s.SalonAdi) salonunu silmek istediğinize emin misiniz?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <input type="hidden" name="geriDonBinaId" value="@seciliBinaId" />
                                                        <button type="submit" class="btn-action btn-danger-soft" title="Sil">
                                                            🗑️
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        }
                    </table>
                </div>
            </div>
        </div>

        <!-- SAĞ: Ekleme Formları -->
        <div class="col-lg-4">
            <div class="panel-card">
                
                <ul class="nav nav-tabs px-3 pt-3 bg-light" id="salonTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="derslik-tab" data-bs-toggle="tab" data-bs-target="#derslik-panel" type="button" role="tab">🚪 Salon / Derslik</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="bina-tab" data-bs-toggle="tab" data-bs-target="#bina-panel" type="button" role="tab">🏢 Bina</button>
                    </li>
                </ul>

                <div class="tab-content p-4" id="salonTabContent">
                    
                    <!-- DERSLİK EKLEME TAB'I -->
                    <div class="tab-pane fade show active" id="derslik-panel" role="tabpanel">
                        <form asp-action="SalonEkle" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="geriDonBinaId" value="@seciliBinaId" />

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted mb-1">Bağlı Olduğu Bina <span class="text-danger">*</span></label>
                                <select name="binaId" id="formBinaSelect" class="form-select" required>
                                    <option value="">-- Bina Seçiniz --</option>
                                    @foreach (var b in binalar)
                                    {
                                        if (seciliBinaId == b.Id)
                                        {
                                            <option value="@b.Id" selected>@b.SalonAdi</option>
                                        }
                                        else
                                        {
                                            <option value="@b.Id">@b.SalonAdi</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted mb-1">Salon Tipi <span class="text-danger">*</span></label>
                                <select name="salonTipi" class="form-select" required>
                                    <option value="Sinif" selected>Sınıf</option>
                                    <option value="Amfi">Amfi</option>
                                    <option value="Laboratuvar">Laboratuvar</option>
                                    <option value="Toplanti Salonu">Toplantı Salonu</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted mb-1">Salon Adı (Örn: B101) <span class="text-danger">*</span></label>
                                <input type="text" name="salonAdi" id="formSalonAdi" class="form-control" maxlength="20" required />
                                <div id="salonAdiHint" style="font-size:0.78rem; margin-top:4px; min-height:16px;"></div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small text-muted mb-1">Kapasite (Kişi) <span class="text-danger">*</span></label>
                                <input type="number" name="kapasite" class="form-control" value="30" min="1" max="1000" required />
                            </div>

                            <button type="submit" id="salonBtn" class="btn btn-primary w-100 fw-bold py-2">
                                ➕ Derslik Ekle
                            </button>
                        </form>
                    </div>

                    <!-- BİNA EKLEME TAB'I -->
                    <div class="tab-pane fade" id="bina-panel" role="tabpanel">
                        <form asp-action="BinaEkle" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()

                            <div class="alert alert-info py-2 small" style="background:#eff6ff; border-color:#bfdbfe; color:#1e40af;">
                                Önce Fakülte Binasını oluşturup, ardından bu binanın içine derslik ve amfileri ekleyebilirsiniz.
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small text-muted mb-1">Bina Adı <span class="text-danger">*</span></label>
                                <input type="text" name="binaAdi" class="form-control" placeholder="Örn: Mühendislik Fakültesi Binası" maxlength="50" required />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                🏢 Binayı Sisteme Ekle
                            </button>
                        </form>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    (function(){
        // AJAX: Aynı binada aynı salon var mı?
        const binaSel = document.getElementById('formBinaSelect');
        const salonInp = document.getElementById('formSalonAdi');
        const hint = document.getElementById('salonAdiHint');
        const btn = document.getElementById('salonBtn');
        let timer = null;

        function checkAdi() {
            if(!binaSel || !salonInp) return;
            const bId = binaSel.value;
            const sAd = salonInp.value.trim();

            if(!bId || !sAd) {
                hint.textContent = '';
                btn.disabled = false;
                return;
            }

            hint.style.color = '#64748b';
            hint.textContent = '⏳ Kontrol ediliyor...';

            clearTimeout(timer);
            timer = setTimeout(() => {
                fetch(`/Admin/SalonAdiKontrol?binaId=${bId}&salonAdi=${encodeURIComponent(sAd)}`)
                    .then(r => r.json())
                    .then(data => {
                        if(data.kullanildi) {
                            hint.style.color = '#dc2626';
                            hint.textContent = `✗ Bu binada '${sAd}' isminde bir salon zaten var.`;
                            btn.disabled = true;
                        } else {
                            hint.style.color = '#059669';
                            hint.textContent = '✓ İsim kullanılabilir.';
                            btn.disabled = false;
                        }
                    })
                    .catch(() => {
                        hint.textContent = '';
                        btn.disabled = false;
                    });
            }, 300);
        }

        if(binaSel) binaSel.addEventListener('change', checkAdi);
        if(salonInp) salonInp.addEventListener('input', checkAdi);
    })();
</script>
}
