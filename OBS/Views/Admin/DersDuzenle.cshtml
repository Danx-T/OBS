@model OBS.ViewModels.DersDuzenleViewModel
@{
    ViewData["Title"] = "Ders Düzenle";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">✏️ Ders Düzenle</h2>
        <a asp-action="DersYonetimi" class="btn btn-outline-secondary" style="border-radius:10px; font-weight:600;">
            ← Geri Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:15px; overflow:hidden;">
        <div class="card-body p-4 p-md-5">
            <form asp-action="DersDuzenle" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="DersKodu" class="form-label fw-bold text-muted">Ders Kodu</label>
                        <input asp-for="DersKodu" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="DersKodu" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="DersAdi" class="form-label fw-bold text-muted">Ders Adı</label>
                        <input asp-for="DersAdi" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="DersAdi" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="OrganizasyonId" class="form-label fw-bold text-muted">Bağlı Olduğu Bölüm</label>
                        <select asp-for="OrganizasyonId" class="form-select bg-light border-0" style="padding:0.75rem 1rem;" asp-items="ViewBag.Bolumler">
                            <option value="">-- Seçiniz --</option>
                        </select>
                        <span asp-validation-for="OrganizasyonId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DersTuru" class="form-label fw-bold text-muted">Ders Türü</label>
                        <select asp-for="DersTuru" class="form-select bg-light border-0" style="padding:0.75rem 1rem;">
                            <option value="Zorunlu">Zorunlu</option>
                            <option value="Secmeli">Seçmeli</option>
                        </select>
                        <span asp-validation-for="DersTuru" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Kredi" class="form-label fw-bold text-muted">Kredi</label>
                        <input asp-for="Kredi" type="number" step="0.5" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Kredi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Akts" class="form-label fw-bold text-muted">AKTS</label>
                        <input asp-for="Akts" type="number" step="0.5" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Akts" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Teorik" class="form-label fw-bold text-muted">Teorik Saat</label>
                        <input asp-for="Teorik" type="number" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Teorik" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Uygulama" class="form-label fw-bold text-muted">Uygulama Saat</label>
                        <input asp-for="Uygulama" type="number" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Uygulama" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted">Durum</label>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="AktiflikDurumu" style="transform: scale(1.5); margin-left: -1.5rem;" />
                            <label class="form-check-label ms-3" asp-for="AktiflikDurumu">Aktif (İşaretliyse)</label>
                        </div>
                    </div>

                    <div class="col-12 mt-5">
                        <button type="submit" class="btn btn-primary px-5 py-2" style="border-radius:10px; font-weight:600;">
                            Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
