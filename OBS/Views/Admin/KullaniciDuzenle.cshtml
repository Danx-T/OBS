@model OBS.ViewModels.KullaniciDuzenleViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">✏️ Kullanıcı Düzenle</h2>
        <a asp-action="KullaniciYonetimi" class="btn btn-outline-secondary" style="border-radius:10px; font-weight:600;">
            ← Geri Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:15px; overflow:hidden;">
        <div class="card-body p-4 p-md-5">
            <form asp-action="KullaniciDuzenle" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Ad" class="form-label fw-bold text-muted">Ad</label>
                        <input asp-for="Ad" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Ad" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Soyad" class="form-label fw-bold text-muted">Soyad</label>
                        <input asp-for="Soyad" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Soyad" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Eposta" class="form-label fw-bold text-muted">E-posta</label>
                        <input asp-for="Eposta" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Eposta" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefon" class="form-label fw-bold text-muted">Telefon</label>
                        <input asp-for="Telefon" class="form-control bg-light border-0" style="padding:0.75rem 1rem;" />
                        <span asp-validation-for="Telefon" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-5">
                        <button type="submit" class="btn btn-primary px-5 py-2" style="border-radius:10px; font-weight:600;">
                            Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
