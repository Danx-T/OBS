@model IEnumerable<OBS.Models.Donem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AkademikYil)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Donem1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BaslangicTarihi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BitisTarihi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DersKaydiBaslangic)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DersKaydiBitis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AcilanDers)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.AkademikYil)
            </td>
            <td>
                @Html.DisplayFor(model => item.Donem1)
            </td>
            <td>
                @Html.DisplayFor(model => item.BaslangicTarihi)
            </td>
            <td>
                @Html.DisplayFor(model => item.BitisTarihi)
            </td>
            <td>
                @Html.DisplayFor(model => item.DersKaydiBaslangic)
            </td>
            <td>
                @Html.DisplayFor(model => item.DersKaydiBitis)
            </td>
            <td>
                @Html.DisplayFor(model => item.AcilanDers)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
