<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OBS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OBS.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body, button, input, select, textarea, .nav-link, table, h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif !important;
            font-size: 0.96rem;
            letter-spacing: -0.01em;
        }
    </style>
</head>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, null, new Microsoft.AspNetCore.Authorization.Infrastructure.RolesAuthorizationRequirement(new[] { "Admin" }))).Succeeded;
    var isOgrenci = User.HasClaim("UserType", "Ogrenci");
    var hasSidebar = isAdmin || isOgrenci;
}
<body>
    @if (isAdmin)
    {
        @await Html.PartialAsync("_AdminNavbar")
    }
    else if (isOgrenci)
    {
        @await Html.PartialAsync("_StudentNavbar")
    }

    <div class="@(hasSidebar ? "ms-auto" : "container")" style="@(hasSidebar ? "margin-left: 250px !important; padding: 20px;" : "")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
