@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@if ((await AuthorizationService.AuthorizeAsync(User, null, new Microsoft.AspNetCore.Authorization.Infrastructure.RolesAuthorizationRequirement(new[] { "Admin" }))).Succeeded)
{
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    <aside class="bg-dark text-white p-3 position-fixed top-0 start-0 bottom-0 d-flex flex-column" style="width: 240px; z-index: 1050;">
        <div class="mb-4 px-2">
            <span class="fs-5 fw-bold text-white">Yönetici Paneli</span>
        </div>

        <ul class="nav nav-pills flex-column mb-auto gap-1">
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="KullaniciOlustur" class="nav-link text-white @(action == "KullaniciOlustur" ? "active bg-primary" : "")">
                    ➕ Kullanıcı Oluştur
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="KullaniciYonetimi" class="nav-link text-white @(action == "KullaniciYonetimi" ? "active bg-primary" : "")">
                    👥 Kullanıcı Yönetimi
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="DanismanAtama" class="nav-link text-white @(action == "DanismanAtama" ? "active bg-primary" : "")">
                    👨‍🏫 Danışman Atama
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="RolYetkiYonetimi" class="nav-link text-white @(action == "RolYetkiYonetimi" ? "active bg-primary" : "")">
                    🔑 Rol &amp; Yetki Yönetimi
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="KullaniciYetkilendirme" class="nav-link text-white @(action == "KullaniciYetkilendirme" ? "active bg-primary" : "")">
                    👤 Kullanıcı Yetkileri
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Admin" asp-action="OrganizasyonYonetimi" class="nav-link text-white @(action == "OrganizasyonYonetimi" ? "active bg-primary" : "")">
                    🏛️ Organizasyon Yönetimi
                </a>
            </li>
        </ul>

        <div class="border-top border-secondary pt-3 px-2 d-flex align-items-center justify-content-between">
            <span class="small text-light text-truncate" style="max-width: 140px;">@User.Identity!.Name</span>
            <form asp-action="Logout" asp-controller="Auth" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">Çıkış</button>
            </form>
        </div>
    </aside>
}
