@inject OBS.Models.ObsContext _context
@using System.Security.Claims
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdvisor = false;
    if (int.TryParse(userIdStr, out int userId))
    {
        isAdvisor = _context.Ogrencis.Any(o => o.Danisman!.KullaniciId == userId);
    }
}

<aside class="bg-dark text-white p-3 position-fixed top-0 start-0 bottom-0 d-flex flex-column" style="width: 240px; z-index: 1050;">
    <div class="mb-4 px-2">
        <span class="fs-5 fw-bold text-white">Akademisyen Paneli</span>
    </div>

    <ul class="nav nav-pills flex-column mb-auto gap-1">
        <li class="nav-item">
            <a asp-controller="Academician" asp-action="Index" class="nav-link text-white @(action == "Index" ? "active bg-primary" : "")">
                🏠 Ana Sayfa
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Academician" asp-action="Courses" class="nav-link text-white @(action == "Courses" || action == "CourseStudents" ? "active bg-primary" : "")">
                📚 Derslerim
            </a>
        </li>
        @if (isAdvisor)
        {
            <li class="nav-item">
                <a asp-controller="Academician" asp-action="AdvisorApprovals" class="nav-link text-white @(action == "AdvisorApprovals" ? "active bg-primary" : "")">
                    👨‍🎓 Danışmanlık İşlemleri
                </a>
            </li>
        }
        <li class="nav-item">
            <a asp-controller="Academician" asp-action="Schedule" class="nav-link text-white @(action == "Schedule" ? "active bg-primary" : "")">
                📅 Ders Programı
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Academician" asp-action="Exams" class="nav-link text-white @(action == "Exams" ? "active bg-primary" : "")">
                📝 Sınav Programı
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Academician" asp-action="GradeEntry" class="nav-link text-white @(action == "GradeEntry" || action == "GradeEntryDetail" ? "active bg-primary" : "")">
                💯 Not Girişi
            </a>
        </li>
    </ul>

    <div class="border-top border-secondary pt-3 px-2 d-flex align-items-center justify-content-between">
        <span class="small text-light text-truncate" style="max-width: 140px;">@User.Identity!.Name</span>
        <form asp-action="Logout" asp-controller="Auth" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">Çıkış</button>
        </form>
    </div>
</aside>
