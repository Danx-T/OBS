@model OBS.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - OBS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 2rem 0;
        }

        .auth-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.10);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 440px;
        }

        .auth-card h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .auth-card .subtitle {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 1.75rem;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
        }

        .btn-primary {
            background-color: #2563eb;
            border-color: #2563eb;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
        }

        .auth-footer {
            text-align: center;
            margin-top: 1.25rem;
            font-size: 0.875rem;
            color: #6c757d;
        }

        .auth-footer a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .brand {
            text-align: center;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            font-weight: 700;
            color: #2563eb;
            letter-spacing: 0.05em;
        }

        /* Şifre göster/gizle */
        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 2.75rem;
        }

        .toggle-password {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #6c757d;
            padding: 0;
            font-size: 1rem;
            line-height: 1;
        }

        .toggle-password:hover {
            color: #2563eb;
        }

        /* Şifre gereksinimleri */
        .password-rules {
            margin-top: 0.5rem;
            padding: 0.75rem 1rem;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            display: none;
        }

        .password-rules.visible {
            display: block;
        }

        .rule-item {
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-bottom: 0.25rem;
            color: #6b7280;
            transition: color 0.2s;
        }

        .rule-item:last-child {
            margin-bottom: 0;
        }

        .rule-item.ok {
            color: #16a34a;
        }

        .rule-item.fail {
            color: #dc2626;
        }

        .rule-icon {
            font-size: 0.75rem;
            width: 14px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="brand">📚 OBS</div>
        <h1>Kayıt Ol</h1>
        <p class="subtitle">Yeni hesap oluşturmak için formu doldurunuz.</p>

        <form asp-action="Register" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row mb-3">
                <div class="col">
                    <label asp-for="Ad" class="form-label">Ad</label>
                    <input asp-for="Ad" class="form-control" placeholder="Adınız" />
                    <span asp-validation-for="Ad" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="Soyad" class="form-label">Soyad</label>
                    <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
                    <span asp-validation-for="Soyad" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Eposta" class="form-label">E-posta</label>
                <input asp-for="Eposta" class="form-control" placeholder="ornek@mail.com" autocomplete="email" />
                <span asp-validation-for="Eposta" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefon" class="form-label">Telefon</label>
                <input asp-for="Telefon" class="form-control" placeholder="05xx xxx xx xx" autocomplete="tel" />
                <span asp-validation-for="Telefon" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sifre" class="form-label">Şifre</label>
                <div class="password-wrapper">
                    <input asp-for="Sifre" id="sifreInput" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                    <button type="button" class="toggle-password" onclick="togglePassword('sifreInput', 'eyeIcon1')" title="Şifreyi göster/gizle">
                        <svg id="eyeIcon1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Sifre" class="text-danger small"></span>

                <!-- Şifre gereksinimleri -->
                <div class="password-rules" id="passwordRules">
                    <div class="rule-item" id="rule-length">
                        <span class="rule-icon">✕</span> En az 8 karakter
                    </div>
                    <div class="rule-item" id="rule-upper">
                        <span class="rule-icon">✕</span> En az 1 büyük harf
                    </div>
                    <div class="rule-item" id="rule-lower">
                        <span class="rule-icon">✕</span> En az 1 küçük harf
                    </div>
                    <div class="rule-item" id="rule-digit">
                        <span class="rule-icon">✕</span> En az 1 rakam
                    </div>
                    <div class="rule-item" id="rule-special">
                        <span class="rule-icon">✕</span> En az 1 özel karakter (!@@#$ vb.)
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="SifreOnay" class="form-label">Şifre Onayı</label>
                <div class="password-wrapper">
                    <input asp-for="SifreOnay" id="sifreOnayInput" class="form-control" placeholder="Şifrenizi tekrar giriniz" autocomplete="new-password" />
                    <button type="button" class="toggle-password" onclick="togglePassword('sifreOnayInput', 'eyeIcon2')" title="Şifreyi göster/gizle">
                        <svg id="eyeIcon2" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="SifreOnay" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
        </form>

        <div class="auth-footer">
            Zaten hesabınız var mı? <a asp-action="Login" asp-controller="Auth">Giriş Yap</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Şifre göster/gizle
        const eyeOpenPath   = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
        const eyeClosedPath = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = eyeClosedPath;
            } else {
                input.type = 'password';
                icon.innerHTML = eyeOpenPath;
            }
        }

        // Şifre gereksinimleri canlı kontrol
        const sifreInput = document.getElementById('sifreInput');
        const rules = document.getElementById('passwordRules');

        sifreInput.addEventListener('focus', () => rules.classList.add('visible'));
        sifreInput.addEventListener('blur', () => {
            if (sifreInput.value === '') rules.classList.remove('visible');
        });

        sifreInput.addEventListener('input', function () {
            const val = this.value;

            checkRule('rule-length',  val.length >= 8);
            checkRule('rule-upper',   /[A-Z]/.test(val));
            checkRule('rule-lower',   /[a-z]/.test(val));
            checkRule('rule-digit',   /\d/.test(val));
            checkRule('rule-special', /[^a-zA-Z\d]/.test(val));
        });

        function checkRule(id, passed) {
            const el = document.getElementById(id);
            const icon = el.querySelector('.rule-icon');
            if (passed) {
                el.classList.add('ok');
                el.classList.remove('fail');
                icon.textContent = '✓';
            } else {
                el.classList.add('fail');
                el.classList.remove('ok');
                icon.textContent = '✕';
            }
        }
    </script>
</body>
</html>
