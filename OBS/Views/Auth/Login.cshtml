@model OBS.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - OBS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .auth-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.10);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 400px;
        }

        .auth-card h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .auth-card .subtitle {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 1.75rem;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
        }

        .btn-primary {
            background-color: #2563eb;
            border-color: #2563eb;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
        }

        .auth-footer {
            text-align: center;
            margin-top: 1.25rem;
            font-size: 0.875rem;
            color: #6c757d;
        }

        .auth-footer a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .brand {
            text-align: center;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            font-weight: 700;
            color: #2563eb;
            letter-spacing: 0.05em;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 2.75rem;
        }

        .toggle-password {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #6c757d;
            padding: 0;
            font-size: 1rem;
            line-height: 1;
        }

        .toggle-password:hover {
            color: #2563eb;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="brand">📚 OBS</div>
        <h1>Giriş Yap</h1>
        <p class="subtitle">Sisteme erişmek için giriş yapınız.</p>

        @if (TempData["Basari"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                @TempData["Basari"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Login" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Eposta" class="form-label">E-posta</label>
                <input asp-for="Eposta" class="form-control" placeholder="ornek@mail.com" autocomplete="email" />
                <span asp-validation-for="Eposta" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Sifre" class="form-label">Şifre</label>
                <div class="password-wrapper">
                    <input asp-for="Sifre" id="loginSifre" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="toggle-password" onclick="togglePassword()" title="Şifreyi göster/gizle">
                        <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Sifre" class="text-danger small"></span>
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
        </form>

        <div class="auth-footer">
            Hesabınız yok mu? <a asp-action="Register" asp-controller="Auth">Kayıt Ol</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const eyeOpenPath  = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
        const eyeClosedPath = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';

        function togglePassword() {
            const input = document.getElementById('loginSifre');
            const icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = eyeClosedPath;
            } else {
                input.type = 'password';
                icon.innerHTML = eyeOpenPath;
            }
        }
    </script>
</body>
</html>
