@model OBS.ViewModels.SetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Şifrenizi Belirleyin";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Şifrenizi Belirleyin - OBS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .auth-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.10);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 400px;
        }

        .brand {
            text-align: center;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            font-weight: 700;
            color: #2563eb;
            letter-spacing: 0.05em;
        }

        .auth-card h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .auth-card .subtitle {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 1.25rem;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
        }

        .btn-primary {
            background-color: #2563eb;
            border-color: #2563eb;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
        }

        .auth-footer {
            text-align: center;
            margin-top: 1.25rem;
            font-size: 0.875rem;
            color: #6c757d;
        }

        .auth-footer a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .welcome-box {
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.25rem;
            font-size: 0.875rem;
            color: #495057;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 2.75rem;
        }

        .toggle-password {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
        }

        .toggle-password:hover {
            color: #212529;
        }

        .password-rules {
            margin-top: 0.5rem;
            padding: 0.75rem 1rem;
            background: #f8f9fa;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            display: none;
        }

        .password-rules.visible {
            display: block;
        }

        .rule-item {
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-bottom: 0.25rem;
            color: #6b7280;
            transition: color 0.2s;
        }

        .rule-item:last-child {
            margin-bottom: 0;
        }

        .rule-item.ok {
            color: #16a34a;
        }

        .rule-item.fail {
            color: #dc2626;
        }

        .rule-icon {
            font-size: 0.75rem;
            width: 14px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="brand">OBS - ÖĞRENCİ BİLGİ SİSTEMİ</div>

        <h1>Hoş Geldiniz</h1>
        <p class="subtitle">Sisteme giriş yapabilmek için lütfen şifrenizi belirleyiniz.</p>

        @if (!string.IsNullOrEmpty(Model.AdSoyad))
        {
            <div class="welcome-box">
                Merhaba <strong>@Model.AdSoyad</strong><br />
                <span class="text-muted" style="font-size: 0.8rem;">@Model.Eposta</span>
            </div>
        }

        <form asp-action="SetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="AdSoyad" />
            <input type="hidden" asp-for="Eposta" />

            <div class="mb-3">
                <label asp-for="Sifre" class="form-label">Yeni Şifre</label>
                <div class="password-wrapper">
                    <input asp-for="Sifre" id="sifre1" class="form-control" placeholder="••••••••" autocomplete="new-password" autofocus />
                    <button type="button" class="toggle-password" onclick="togglePwd('sifre1','eye1')" title="Göster/Gizle">
                        <svg id="eye1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Sifre" class="text-danger small"></span>

                <!-- Şifre gereksinimleri -->
                <div class="password-rules visible" id="passwordRules">
                    <div class="rule-item" id="rule-length">
                        <span class="rule-icon">✕</span> En az 8 karakter
                    </div>
                    <div class="rule-item" id="rule-upper">
                        <span class="rule-icon">✕</span> En az 1 büyük harf
                    </div>
                    <div class="rule-item" id="rule-lower">
                        <span class="rule-icon">✕</span> En az 1 küçük harf
                    </div>
                    <div class="rule-item" id="rule-digit">
                        <span class="rule-icon">✕</span> En az 1 rakam
                    </div>
                    <div class="rule-item" id="rule-special">
                        <span class="rule-icon">✕</span> En az 1 özel karakter (!@@#$ vb.)
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="SifreTekrar" class="form-label">Yeni Şifre (Tekrar)</label>
                <div class="password-wrapper">
                    <input asp-for="SifreTekrar" id="sifre2" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                    <button type="button" class="toggle-password" onclick="togglePwd('sifre2','eye2')" title="Göster/Gizle">
                        <svg id="eye2" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <button type="submit" class="btn btn-primary w-100">Şifremi Belirle ve Giriş Yap</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login">← Giriş sayfasına dön</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const eyeOpen   = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
        const eyeClosed = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';

        function togglePwd(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = eyeClosed;
            } else {
                input.type = 'password';
                icon.innerHTML = eyeOpen;
            }
        }

        // Şifre gereksinimleri canlı kontrol
        const sifreInput = document.getElementById('sifre1');
        const rules = document.getElementById('passwordRules');

        function updateRules(val) {
            checkRule('rule-length',  val.length >= 8);
            checkRule('rule-upper',   /[A-Z]/.test(val));
            checkRule('rule-lower',   /[a-z]/.test(val));
            checkRule('rule-digit',   /\d/.test(val));
            checkRule('rule-special', /[^a-zA-Z\d]/.test(val));
        }

        // Sayfa açıldığında gereksinim kutusu her zaman görünür olsun ve anlık değer kontrol edilsin
        rules.classList.add('visible');
        updateRules(sifreInput.value);

        sifreInput.addEventListener('input', function () {
            updateRules(this.value);
        });

        function checkRule(id, passed) {
            const el   = document.getElementById(id);
            const icon = el.querySelector('.rule-icon');
            if (passed) {
                el.classList.add('ok');
                el.classList.remove('fail');
                icon.textContent = '✓';
            } else {
                el.classList.add('fail');
                el.classList.remove('ok');
                icon.textContent = '✕';
            }
        }
    </script>
</body>
</html>
