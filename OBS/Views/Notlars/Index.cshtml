@model IEnumerable<OBS.Models.Notlar>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DersKaydiId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OlcmeTuru)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Puan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DersKaydi)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.DersKaydiId)
            </td>
            <td>
                @Html.DisplayFor(model => item.OlcmeTuru)
            </td>
            <td>
                @Html.DisplayFor(model => item.Puan)
            </td>
            <td>
                @Html.DisplayFor(model => item.DersKaydi)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
